# ==============================================================================
# KAALCHAKRA — ENVIRONMENT CONFIGURATION
# ==============================================================================
# The browser client uses Supabase publishable/anon credentials.
# Database access is protected by PostgreSQL Row Level Security (RLS).

# Supabase Project URL (From Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Key (Safe for browser client)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
# Note: VITE_SUPABASE_ANON_KEY is also supported as an alias
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ==============================================================================
# SERVER-SIDE SECRETS (DO NOT EXPOSE TO BROWSER / VITE CLIENT)
# ==============================================================================
# Set these in your Supabase Project Settings -> Edge Functions -> Secrets
# or via Supabase CLI: supabase secrets set GEMINI_API_KEY=...
#
# GEMINI_API_KEY=your-google-gemini-api-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-migrations-only
